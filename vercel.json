{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.ts": { "maxDuration": 300 },
    "api/oauth-authorize.ts": { "maxDuration": 15 },
    "api/oauth-token.ts": { "maxDuration": 15 },
    "api/oauth-register.ts": { "maxDuration": 15 },
    "api/oauth-metadata.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/oauth-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/mcp",
      "destination": "/api/oauth-metadata"
    },
    { "source": "/oauth/authorize", "destination": "/api/oauth-authorize" },
    { "source": "/oauth/token", "destination": "/api/oauth-token" },
    { "source": "/oauth/register", "destination": "/api/oauth-register" }
  ]
}
