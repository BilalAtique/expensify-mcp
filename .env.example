# Credentials from https://www.expensify.com/tools/integrations/
# These are shown once at generation time — store them somewhere durable.
EXPENSIFY_PARTNER_USER_ID=
EXPENSIFY_PARTNER_USER_SECRET=

# Write-protection. Defaults to dry-run ON: mutating tools describe what they
# would send and return without calling the API.
# Set to "false" only when you intend to write to real Expensify records.
EXPENSIFY_DRY_RUN=true

# Optional: restrict every mutation to these policy IDs (comma-separated).
# Any write touching a policy outside this list is refused. Empty = no restriction.
EXPENSIFY_ALLOWED_POLICY_IDS=

# Optional: cap on how many expenses a single create call may submit.
EXPENSIFY_MAX_BATCH_SIZE=100
